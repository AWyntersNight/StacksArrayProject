#include <iostream>
#include <string>
#include <stack>
using namespace std;
//Stacks and Arrays Programming Project
//Alexandra Gutierrez & Wynter Horrigan

//Checking if stack is empty
bool empty(int topNum)
{
    if (topNum == -1)
    {
        return true;
    }
    else
    {
        return false;
    }
}

//Checking if stack is full
bool full(int topNum)
{
    if (topNum == 4)
    {
        return true;
    }
    else
    {
        return false;
    }
}

//Function to push a number to the stack
void push(int& stack, int& topNum)
{
    int temp;
    if (full(topNum))
    {
        cout << "Error: Overflow. Stack is full." << endl;
    }
    else
    {
        cout << "Enter a number between 0 and 99" << endl << endl;
        cin >> temp;
        if (temp >= 0 && temp <= 99)
        {
            topNum++;
            stack = temp;
        }
        else
        {
            cout << "Invalid input" << endl;
        }
    }
}

//Function to pop a number from the stack
void pop(int& stack, int& topNum)
{
    if (empty(topNum))
    {
        cout << "Error: Underflow. Stack is empty." << endl;
    }
    else
    {
        cout << stack << " is popped" << endl;
        topNum--;
    }
}

//Function to output the top element of the stack
void top(int& stack, int& topNum)
{
    if (empty(topNum))
    {
        cout << "Error: Underflow. Stack is empty" << endl;
    }
    else
    {
        cout << stack << " is the top of the stack" << endl;
    }
}

//Function to purge the stack (clear all elements)
void purge(int& topNum)
{
    if (empty(topNum))
    {
        cout << "Error: Underflow. Stack is empty" << endl;
    }
    else
    {
        cout << "Stack purged" << endl;
        topNum = -1;
    }
}

int main() 
{
    int stack[] = {0, 0, 0, 0, 0};
    int topNum = -1;
    int temp;
    string myChoice;

    while (true) {
        temp = topNum + 1;
        //Menu
        cout << "\nStack Menu Prompt" << endl << endl;
        cout << "Type A to push a number to the stack" << endl;
        cout << "Type B to pop a number from the stack" << endl;
        cout << "Type C to output the top of the stack" << endl;
        cout << "Type D to purge the stack" << endl << endl;
        //Input from user for the Menu
        cin >> myChoice;
        cout << endl;

        //Output actions based on user input
        if (myChoice == "A")
        {
            push(stack[temp], topNum);
        }
        else if (myChoice == "B")
        {
            pop(stack[topNum], topNum);
        }
        else if (myChoice == "C")
        {
            top(stack[topNum], topNum);
        }
        else if (myChoice == "D")
        {
            purge(topNum);
        }
        else
        {
            cout << "Invalid choice. Please try again." << endl;
        }
        
        //Output contents of the stack
        cout << "Items on the stack: ";
        for (int i = 0; i <= topNum; i++)
        {
            cout << stack[i] << " ";
        }
        cout << endl;
    }

    return 0;
}
